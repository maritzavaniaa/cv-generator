# Neon PostgreSQL connection string.
# Get this from your Neon project dashboard (Connection Details).
DATABASE_URL=

# Auth.js
# Generate with: openssl rand -base64 33
AUTH_SECRET=

# Google OAuth credentials (Google Cloud Console > APIs & Services > Credentials).
# See README.md for the exact Authorized JavaScript origins / redirect URI to configure.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
