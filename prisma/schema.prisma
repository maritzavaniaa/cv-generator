// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// -----------------------------------------------------------------------------
// Phase 1 update — Auth.js v5 + @auth/prisma-adapter:
//
// Added Account, Session, VerificationToken (the adapter's required models,
// verified against @auth/prisma-adapter@2.11.3's own source and the official
// Auth.js Prisma schema). No Authenticator model — that's only needed for the
// WebAuthn provider, which this project doesn't use (Google OAuth only).
//
// User changes:
//   - Added `image` (String?) and `emailVerified` (DateTime?) — required so
//     Prisma doesn't throw "Unknown argument" when the adapter's createUser
//     writes these fields (Google's OAuth profile always supplies `image`).
//   - `name` relaxed to optional to match the official AdapterUser shape
//     exactly (Google always sends it in practice, but the adapter's type
//     allows null).
//   - `googleId` relaxed to optional and DEPRECATED (see below) rather than
//     removed, to avoid a destructive migration on a field Phase 0 added
//     intentionally.
//
// googleId decision (kept, deprecated, not dropped):
//   Its original purpose — matching/creating a user from their Google
//   identity — is now fully covered by Account.provider + providerAccountId,
//   which @auth/prisma-adapter manages automatically. Auth.js's adapter has
//   no knowledge of `googleId` and will never write to it, so as a required
//   (NOT NULL) column it would make every first-login user creation fail
//   with a "missing required argument" error. Relaxing it to optional fixes
//   that with a non-destructive constraint change (DROP NOT NULL — no data
//   loss, no column removal) instead of dropping the column outright. The
//   table has zero rows, so either choice is equally safe data-wise; this
//   one is simply the smaller, fully-reversible change.
// -----------------------------------------------------------------------------

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id @default(uuid())
  /// Deprecated — superseded by Account.provider + providerAccountId. Kept
  /// nullable rather than dropped; see the schema-file header for why.
  googleId      String?   @unique @map("google_id")
  email         String    @unique
  emailVerified DateTime? @map("email_verified")
  name          String?
  image         String?
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  libraryItems LibraryItem[]
  cvLineages   CvLineage[]
  accounts     Account[]
  sessions     Session[]

  @@map("users")
}

model Account {
  id                String  @id @default(uuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model LibraryItem {
  id     String @id @default(uuid())
  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Plain string (not an enum) on purpose — NFR-7 requires adding a new
  // section category without a heavy migration; an enum would need
  // ALTER TYPE for every new value.
  sectionType String @map("section_type")

  title     String
  subtitle  String?
  startDate DateTime  @map("start_date")
  endDate   DateTime? @map("end_date")
  bullets   Json

  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@index([userId])
  @@map("library_items")
}

model CvLineage {
  id     String @id @default(uuid())
  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  label  String
  target String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  versions CvVersion[]

  @@index([userId])
  @@map("cv_lineages")
}

model CvVersion {
  id        String    @id @default(uuid())
  lineageId String    @map("lineage_id")
  lineage   CvLineage @relation(fields: [lineageId], references: [id], onDelete: Cascade)

  versionNumber   Int    @map("version_number")
  templateId      String @map("template_id")
  snapshot        Json
  selectedItemIds Json   @map("selected_item_ids")

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([lineageId, versionNumber])
  @@index([lineageId])
  @@map("cv_versions")
}
